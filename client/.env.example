# ─────────────────────────────────────────────────────────────
# Skillora Client Environment Configuration
# ─────────────────────────────────────────────────────────────

# Local Development:
# VITE_SERVER_URL=http://localhost:5000
# VITE_API_URL=/api

# Production (Vercel):
# Set VITE_SERVER_URL to your live Render backend URL
VITE_SERVER_URL=https://skillora-api.onrender.com

# Optional (defaults to VITE_SERVER_URL/api automatically)
VITE_API_URL=https://skillora-api.onrender.com/api

