# ══════════════════════════════════════════════════════════════════════════════
#  SKILLORA — Enterprise-Grade .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
package-lock.json.bak
pnpm-lock.yaml.bak
yarn-error.log*
.pnpm-store/

# ── Build & Distribution Outputs ─────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.fusebox/
.dynamodb/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Environment & Secrets (NEVER commit secrets to VCS) ─────────────────────
.env
.env.*
!.env.example
*.env.local
server/.env
client/.env
server/.env.local
client/.env.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.p8
secrets/
credentials.json
service-account*.json

# ── Logs & Runtime State ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock
.node_repl_history
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
node_inspect_*.json

# ── Testing & Code Coverage ──────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
jest-results/
playwright-report/
test-results/
blob-report/
cypress/videos/
cypress/screenshots/
.allure/
allure-results/
allure-report/

# ── Caching & Bundler Artifacts ──────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.vite/
.turbo/
.tailwindcache/
.temp/
.tmp/
tmp/
temp/
scratch/

# ── Video & Media Assets ─────────────────────────────────────────────────────
video/
client/public/videos/*
!client/public/videos/landing-bg.mp4
*.mp4
!client/public/videos/landing-bg.mp4
*.webm
*.mov
*.avi
*.mkv

# ── Uploads & Local User Data ────────────────────────────────────────────────
uploads/
storage/
media/

# ── Database & Cache Dumps ───────────────────────────────────────────────────
*.dump
*.gz
*.archive
*.sqlite
*.sqlite3
*.db
dump/
mongodump/
*.rdb
dump.rdb

# ── Operating System Artifacts ───────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ── IDEs & Code Editors ──────────────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ IDEA, PhpStorm)
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist
tags

# Sublime Text
*.sublime-project
*.sublime-workspace

# Eclipse
.project
.classpath
.settings/

# ── Sentry & Monitoring ──────────────────────────────────────────────────────
.sentryclirc

# ── AI Agent & IDE Workspaces ────────────────────────────────────────────────
.agents/
.gemini/
.system_generated/
brain/
