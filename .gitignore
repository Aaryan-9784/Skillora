# ══════════════════════════════════════════════════════════════
#  Skillora — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
package-lock.json.bak

# ── Build Outputs ─────────────────────────────────────────────
dist/
dist-ssr/
build/
.next/
out/
*.tsbuildinfo

# ── Environment Variables (NEVER commit secrets) ─────────────
.env
.env.*
!.env.example
server/.env
client/.env

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing & Coverage ───────────────────────────────────────
coverage/
.nyc_output/
*.lcov
jest-results/

# ── Video & Media Assets ────────────────────────────────────
video/
client/public/videos/
*.mp4
*.webm
*.mov
*.avi
*.mkv

# ── Uploaded Files & Temp Media ──────────────────────────────
uploads/
tmp/
temp/

# ── Database Dumps ───────────────────────────────────────────
*.dump
*.gz
*.archive
dump/
mongodump/

# ── Redis ─────────────────────────────────────────────────────
*.rdb
dump.rdb

# ── OS Files ──────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ── Editor & IDE ──────────────────────────────────────────────
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist
tags

# Sublime Text
*.sublime-project
*.sublime-workspace

# ── Cache & Temp ──────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.temp/
.tmp/
scratch/

# Vite
*.local

# Tailwind
.tailwindcache/

# ── Misc ──────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.node_repl_history
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Debug
node_inspect_*.json

# Sentry
.sentryclirc

# AI / Gemini agent artifacts
.agents/
.gemini/
